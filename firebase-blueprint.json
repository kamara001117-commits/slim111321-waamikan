{
  "entities": {
    "user": {
      "title": "User",
      "description": "System user with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "staff"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "product": {
      "title": "Product",
      "description": "Medical supply product in inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Consumables", "Imaging", "Equipment", "Furniture", "Life Support"] },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "integer" },
        "sku": { "type": "string" },
        "image": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price", "stock"]
    },
    "customer": {
      "title": "Customer",
      "description": "Hospital or clinic client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "type": { "type": "string", "enum": ["public", "private"] },
        "totalSpent": { "type": "number" },
        "invoiceCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "invoice": {
      "title": "Invoice",
      "description": "Sales invoice for medical supplies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": "object" }
        },
        "subtotal": { "type": "number" },
        "vat": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "sent", "paid", "partial", "overdue"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "pdfUrl": { "type": "string" }
      },
      "required": ["invoiceNumber", "customerId", "items", "total", "status"]
    },
    "payment": {
      "title": "Payment",
      "description": "Payment record for an invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "reference": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "recordedBy": { "type": "string" }
      },
      "required": ["invoiceId", "amount", "date", "method"]
    },
    "receipt": {
      "title": "Receipt",
      "description": "Official receipt for a payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "paymentId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "amount": { "type": "number" },
        "pdfUrl": { "type": "string" }
      }
    },
    "request": {
      "title": "CRM Request",
      "description": "Contact form or service request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "hospital": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_progress", "responded", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["name", "email", "message", "status"]
    },
    "activityLog": {
      "title": "Activity Log",
      "description": "System audits",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "type": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "account": {
      "title": "Chart of Accounts",
      "description": "General ledger accounts",
      "type": "object",
      "properties": {
         "code": { "type": "string" },
         "name": { "type": "string" },
         "type": { "type": "string" },
         "balance": { "type": "number" }
      }
    },
    "journalEntry": {
      "title": "Journal Entry",
      "description": "Double-entry bookkeeping record",
      "type": "object",
      "properties": {
         "date": { "type": "string" },
         "reference": { "type": "string" },
         "description": { "type": "string" },
         "lines": { "type": "array" },
         "status": { "type": "string" }
      }
    },
    "bankAccount": {
       "title": "Bank Account",
       "description": "Company bank or cash account",
       "type": "object",
       "properties": {
          "name": { "type": "string" },
          "bankName": { "type": "string" },
          "balance": { "type": "number" }
       }
    },
    "bankTransaction": {
       "title": "Bank Transaction",
       "description": "Cash flow record",
       "type": "object",
       "properties": {
          "amount": { "type": "number" },
          "type": { "type": "string" },
          "description": { "type": "string" }
       }
    },
    "supplier": {
       "title": "Supplier",
       "description": "Vendor for procurement",
       "type": "object",
       "properties": {
          "name": { "type": "string" },
          "balance": { "type": "number" }
       }
    },
    "purchaseOrder": {
       "title": "Purchase Order",
       "description": "Inventory purchase request",
       "type": "object",
       "properties": {
          "poNumber": { "type": "string" },
          "total": { "type": "number" },
          "status": { "type": "string" }
       }
    },
    "supplierBill": {
       "title": "Supplier Bill",
       "description": "Vendor invoice (payable) with inventory and accounting integration",
       "type": "object",
       "properties": {
          "id": { "type": "string" },
          "billNumber": { "type": "string" },
          "supplierId": { "type": "string" },
          "supplierName": { "type": "string" },
          "poId": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "dueDate": { "type": "string", "format": "date" },
          "items": { 
             "type": "array",
             "items": {
                "type": "object",
                "properties": {
                   "productId": { "type": "string" },
                   "description": { "type": "string" },
                   "quantity": { "type": "number" },
                   "unitPrice": { "type": "number" },
                   "total": { "type": "number" },
                   "accountId": { "type": "string" }
                }
             }
          },
          "subtotal": { "type": "number" },
          "tax": { "type": "number" },
          "total": { "type": "number" },
          "paidAmount": { "type": "number" },
          "status": { "type": "string", "enum": ["Unpaid", "Partial", "Paid", "Overdue"] },
          "createdAt": { "type": "string", "format": "date-time" }
       },
       "required": ["billNumber", "supplierId", "date", "items", "total", "status"]
    },
    "inventoryLocation": {
       "title": "Inventory Location",
       "description": "Warehouse or storage area",
       "type": "object",
       "properties": {
          "name": { "type": "string" },
          "code": { "type": "string" }
       }
    },
    "inventoryMovement": {
       "title": "Inventory Movement",
       "description": "Stock flow record",
       "type": "object",
       "properties": {
          "quantity": { "type": "number" },
          "type": { "type": "string" }
       }
    },
    "employee": {
       "title": "Employee",
       "description": "Staff member profile",
       "type": "object",
       "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "position": { "type": "string" }
       }
    },
    "payroll": {
       "title": "Payroll",
       "description": "Salary disbursement record",
       "type": "object",
       "properties": {
          "month": { "type": "string" },
          "netPay": { "type": "number" }
       }
    },
    "expenseClaim": {
       "title": "Expense Claim",
       "description": "Employee reimbursement request",
       "type": "object",
       "properties": {
          "amount": { "type": "number" },
          "status": { "type": "string" }
       }
    },
    "salesDocument": {
       "title": "Sales Document",
       "description": "Quotation, Sales Order, or Delivery Note",
       "type": "object",
       "properties": {
          "docNumber": { "type": "string" },
          "type": { "type": "string" },
          "total": { "type": "number" }
       }
    },
    "purchaseQuote": {
       "title": "Purchase Quote",
       "description": "Supplier pricing request",
       "type": "object",
       "properties": {
          "quoteNumber": { "type": "string" },
          "supplierId": { "type": "string" },
          "total": { "type": "number" }
       }
    },
    "goodsReceipt": {
       "title": "Goods Receipt",
       "description": "Record of physical goods arrival",
       "type": "object",
       "properties": {
          "receiptNumber": { "type": "string" },
          "poId": { "type": "string" },
          "items": { "type": "array" }
       }
    },
    "debitNote": {
       "title": "Debit Note",
       "description": "Supplier adjustment / Returns",
       "type": "object",
       "properties": {
          "noteNumber": { "type": "string" },
          "supplierId": { "type": "string" },
          "amount": { "type": "number" }
       }
    },
    "waybill": {
       "title": "Waybill",
       "description": "Logistics and transport tracking",
       "type": "object",
       "properties": {
          "waybillNumber": { "type": "string" },
          "deliveryNoteId": { "type": "string" },
          "status": { "type": "string" }
       }
    },
    "payslip": {
       "title": "Payslip",
       "description": "Employee monthly salary breakdown",
       "type": "object",
       "properties": {
          "employeeId": { "type": "string" },
          "month": { "type": "string" },
          "netPay": { "type": "number" },
          "journalEntryId": { "type": "string" }
       }
    },
    "setting": {
       "title": "System Setting",
       "description": "Configuration and profiles",
       "type": "object",
       "properties": {
          "key": { "type": "string" },
          "value": { "type": "object" }
       }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles and roles"
    },
    "/products/{productId}": {
      "schema": "product",
      "description": "Medical supply products"
    },
    "/customers/{customerId}": {
      "schema": "customer",
      "description": "Client database"
    },
    "/invoices/{invoiceId}": {
      "schema": "invoice",
      "description": "Billing and invoices"
    },
    "/payments/{paymentId}": {
      "schema": "payment",
      "description": "Payment history"
    },
    "/receipts/{receiptId}": {
      "schema": "receipt",
      "description": "Payment receipts"
    },
    "/requests/{requestId}": {
      "schema": "request",
      "description": "CRM and lead tracking"
    },
    "/logs/{logId}": {
      "schema": "activityLog",
      "description": "Audit trails"
    },
    "/counters/{counterId}": {
      "schema": "object",
      "description": "System counters for sequences"
    },
    "/accounts/{accountId}": {
      "schema": "account",
      "description": "Chart of accounts"
    },
    "/journal_entries/{entryId}": {
      "schema": "journalEntry",
      "description": "Accounting journal"
    },
    "/bank_accounts/{bankAccountId}": {
      "schema": "bankAccount",
      "description": "Company bank accounts"
    },
    "/bank_transactions/{transactionId}": {
      "schema": "bankTransaction",
      "description": "Bank account transactions"
    },
    "/suppliers/{supplierId}": {
      "schema": "supplier",
      "description": "Vendor list"
    },
    "/purchase_orders/{poId}": {
      "schema": "purchaseOrder",
      "description": "Inventory purchase orders"
    },
    "/purchase_quotes/{quoteId}": {
      "schema": "purchaseQuote",
      "description": "Request for pricing"
    },
    "/goods_receipts/{receiptId}": {
      "schema": "goodsReceipt",
      "description": "Physical receipt of goods"
    },
    "/debit_notes/{noteId}": {
      "schema": "debitNote",
      "description": "Supplier adjustments"
    },
    "/waybills/{waybillId}": {
      "schema": "waybill",
      "description": "Shipping documents"
    },
    "/payslips/{payslipId}": {
      "schema": "payslip",
      "description": "Monthly payroll records"
    },
    "/settings/{settingId}": {
      "schema": "setting",
      "description": "App configuration"
    },
    "/supplier_bills/{billId}": {
      "schema": "supplierBill",
      "description": "Accounts payable bills"
    },
    "/inventory_locations/{locationId}": {
      "schema": "inventoryLocation",
      "description": "Warehouse locations"
    },
    "/inventory_movements/{movementId}": {
      "schema": "inventoryMovement",
      "description": "Stock movement logs"
    },
    "/employees/{employeeId}": {
      "schema": "employee",
      "description": "Human resources"
    },
    "/payroll/{payrollId}": {
      "schema": "payroll",
      "description": "Salary records"
    },
    "/expense_claims/{claimId}": {
      "schema": "expenseClaim",
      "description": "Staff expenses"
    },
    "/sales_documents/{docId}": {
      "schema": "salesDocument",
      "description": "Sales workflow documents"
    }
  }
}
