rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    
    // Efficiently get user role without recursive lookups
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function hasRole(role) { 
      return isSignedIn() && getUserRole() == role; 
    }
    
    function isSuperAdmin() { return hasRole('super_admin'); }
    function isAdmin() { return hasRole('admin') || isSuperAdmin(); }
    function isStaff() { 
      let role = getUserRole();
      return isSignedIn() && (
        role == 'staff' || 
        role == 'admin' || 
        role == 'super_admin' || 
        role == 'finance_manager' || 
        role == 'inventory_manager' || 
        role == 'sales_staff' || 
        role == 'hr_staff'
      );
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Enterprise Security Blueprints ---

    function isValidAccount(data) {
      return data.keys().hasAll(['code', 'name', 'type', 'balance']) &&
             data.code is string && data.name is string && data.balance is number;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll(['date', 'reference', 'description', 'lines', 'status']) &&
             data.date is string && data.lines is list && data.lines.size() > 0;
    }

    // --- ERP Collection Rules ---

    // Settings
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Accounting & Journal
    match /accounts/{accountId} {
      allow read: if isStaff();
      allow write: if isAdmin();
      allow update: if isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['balance', 'updatedAt']);
    }

    match /journal_entries/{entryId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin(); // Only admins can modify posted journals
    }

    // Banking
    match /bank_accounts/{accountId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /bank_transactions/{txId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
    }

    // Procurement
    match /suppliers/{supplierId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /purchase_quotes/{quoteId} {
      allow read, write: if isStaff();
    }

    match /purchase_orders/{poId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /supplier_bills/{billId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /goods_receipts/{receiptId} {
      allow read, write: if isStaff();
    }

    match /debit_notes/{noteId} {
      allow read, write: if isStaff();
    }

    // Logistics
    match /waybills/{waybillId} {
      allow read, write: if isStaff();
    }

    // Inventory & Warehouse
    match /inventory_locations/{locId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /inventory_movements/{moveId} {
      allow read: if isStaff();
      allow create: if isStaff();
    }

    // Human Resources
    match /employees/{empId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /payroll/{payId} {
      allow read: if isStaff();
      allow create, update: if isAdmin();
    }

    match /expense_claims/{claimId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update: if isStaff();
    }

    // Sales Operations
    match /sales_documents/{docId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
    }

    // --- Core System Collections (Restated) ---

    // USERS: Profile management
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow write: if isSuperAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    // COUNTERS: System sequence counters
    match /counters/{counterId} {
      allow read: if isStaff();
      allow update: if isStaff();
    }

    // PRODUCTS: Public visibility, controlled updates
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt']));
    }

    // CUSTOMERS: Staff and above
    match /customers/{customerId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // INVOICES: Financial tracking
    match /invoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'pdfUrl', 'paidAmount', 'remainingBalance', 'updatedAt']));
    }

    // PAYMENTS: Recorded by staff, deleted by Admin
    match /payments/{paymentId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    // RECEIPTS: Public (with link) or Internal
    match /receipts/{receiptId} {
      allow read: if true; // Accessed via secure URL/PDF
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    // REQUESTS: Public lead creation
    match /requests/{requestId} {
      allow create: if true; // Public contact form
      allow read, update, delete: if isStaff();
    }

    // LOGS: Audit trails
    match /logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn(); // System logs
    }
  }
}
